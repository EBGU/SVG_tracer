# Generated artifacts: never commit them (the repository ships SVG examples only)
out/
output/
bench_out/
build/
__pycache__/
*.pyc
*.log

# Compressed containers are not committed either (the repository keeps plain SVG only)
*.svgz

# Exclude SVG by default, but let the examples/ directory through
*.svg
!examples/*.svg

# Scratch evidence / comparison images
tmp/

# Tooling artifacts: pytest cache and the egg-info of an editable install
.pytest_cache/
*.egg-info/
